---
// src/components/FAQ.astro
const faqs = [
  { q: 'What is this product?', a: 'A project management tool for early-stage teams, launching soon.' },
  { q: 'When will it launch?', a: 'We are targeting Q1 2026. Waitlist members get access first.' },
  { q: 'Do I need a developer?', a: 'No. The form connects to Google Sheets — no code required.' },
  { q: 'Is my data safe?', a: 'Yes. Leads are stored in a private Google Sheet and never shared.' },
  { q: 'How much will it cost?', a: 'Early-access members get special pricing at launch.' },
  { q: 'How do I get support?', a: 'Email hello@product.example.com and we will reply within a day.' },
];
---
<section id="faq" class="bg-white py-20 md:py-24">
  <div class="mx-auto max-w-3xl px-4 md:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center mb-12">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 md:text-4xl">Frequently asked questions</h2>
    </div>
    <div class="space-y-3">
      {faqs.map((f) => (
        <details class="group rounded-xl border border-slate-200 bg-white p-5 open:bg-slate-50">
          <summary class="flex cursor-pointer items-center justify-between text-base font-semibold text-slate-900 list-none">
            {f.q}
            <span class="ml-4 text-brand-600 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-slate-600">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>