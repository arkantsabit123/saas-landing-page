---
// src/components/Navbar.astro
---
<header class="sticky top-0 z-50 border-b border-slate-200/50 bg-white/70 backdrop-blur-md">
  <nav class="mx-auto flex max-w-6xl flex-col items-center gap-3 px-4 py-4 md:flex-row md:justify-between md:gap-0 md:px-6 lg:px-8" aria-label="Main navigation">
    
    <!-- Baris 1: Logo & CTA -->
    <div class="flex w-full items-center justify-between md:w-auto">
      <a href="/" class="text-xl font-bold tracking-tight text-slate-900 hover:text-brand-600 transition-colors">
        Product.
      </a>
      
      <a href="#lead-form" class="rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm shadow-brand-600/20 transition-all hover:bg-brand-700 md:hidden">
        Join
      </a>
    </div>
    
    <!-- Baris 2: Link Menu -->
    <div class="flex w-full flex-wrap justify-center gap-x-6 gap-y-2 md:w-auto md:justify-end md:gap-8">
      <a href="#features" class="text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors">Features</a>
      <a href="#how-it-works" class="text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors">How it works</a>
      <a href="#faq" class="text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors">FAQ</a>
      <a href="#contact" class="text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors">Contact</a>
    </div>

    <!-- Tombol Desktop -->
    <a href="#lead-form" class="hidden rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm shadow-brand-600/20 transition-all hover:bg-brand-700 md:block">
      Join the waitlist
    </a>
    
  </nav>
</header>