---
// src/components/Pricing.astro
---
<section id="pricing" class="mx-auto max-w-6xl px-4 py-16 md:py-20 lg:py-24 text-center">
  <h2 class="text-3xl font-bold tracking-tight text-slate-900 md:text-4xl">Simple, transparent pricing</h2>
  <p class="mt-4 text-lg text-slate-600">Free during early access.</p>
  
  <div class="mx-auto mt-8 max-w-sm rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
    <h3 class="text-xl font-semibold text-slate-900">Early Access</h3>
    <p class="mt-4 text-4xl font-bold text-slate-900">$0<span class="text-base font-normal text-slate-500">/mo</span></p>
    <ul class="mt-6 space-y-3 text-sm text-slate-600 text-left">
      <li class="flex items-center gap-2">✓ Unlimited projects</li>
      <li class="flex items-center gap-2">✓ Priority support</li>
      <li class="flex items-center gap-2">✓ Locked-in launch pricing</li>
    </ul>
    <a href="#lead-form" class="mt-8 block w-full rounded-lg bg-brand-600 px-4 py-3 font-semibold text-white transition-colors hover:bg-brand-700">
      Join the waitlist
    </a>
  </div>
</section>