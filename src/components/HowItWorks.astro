---
// src/components/HowItWorks.astro
const steps = [
  { n: 1, title: 'Join the waitlist', desc: "Drop your email and we'll be in touch." },
  { n: 2, title: 'Get early access', desc: "We'll send your invite before launch." },
  { n: 3, title: 'Start building', desc: 'Log in and launch your first project.' },
];
---
<section id="how-it-works" class="bg-slate-50 py-20 md:py-24">
  <div class="mx-auto max-w-6xl px-4 md:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center mb-16">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 md:text-4xl">How it works</h2>
      <p class="mt-4 text-lg text-slate-600">Three steps from signup to your first project.</p>
    </div>
    <ol class="grid gap-6 md:grid-cols-3">
      {steps.map((s) => (
        <li class="rounded-xl border border-slate-200 bg-white p-6">
          <span class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-full bg-brand-600 text-base font-bold text-white">
            {s.n}
          </span>
          <h3 class="text-lg font-semibold text-slate-900">{s.title}</h3>
          <p class="mt-2 text-slate-600">{s.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>