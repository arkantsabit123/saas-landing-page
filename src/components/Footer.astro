---
// src/components/Footer.astro
---
<footer id="contact" class="border-t border-slate-200 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-2">
      <!-- Contact block -->
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Get in touch</h2>
        <p class="mt-3 text-slate-600">
          Questions before launch? We reply within one business day.
        </p>
        <a href="mailto:hello@product.example.com"
           class="mt-4 inline-block text-base font-medium text-brand-600 hover:text-brand-700 underline underline-offset-4">
          hello@product.example.com
        </a>
      </div>

      <!-- Quick links -->
      <div class="flex flex-col gap-3 md:items-end md:text-right">
        <a href="#features" class="text-sm text-slate-600 hover:text-slate-900">Features</a>
        <a href="#lead-form" class="text-sm text-slate-600 hover:text-slate-900">Join the waitlist</a>
        <a href="#faq" class="text-sm text-slate-600 hover:text-slate-900">FAQ</a>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-slate-200 pt-8 md:flex-row">
      <p class="text-sm text-slate-500">© 2026 Product. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="/privacy" class="text-sm text-slate-500 hover:text-slate-900">Privacy</a>
        <a href="/terms" class="text-sm text-slate-500 hover:text-slate-900">Terms</a>
        <a href="mailto:hello@product.example.com" class="text-sm text-slate-500 hover:text-slate-900">Contact</a>
      </div>
    </div>
  </div>
</footer>