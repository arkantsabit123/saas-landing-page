---
// src/components/Hero.astro
---
<section class="mx-auto max-w-6xl px-4 py-20 text-center md:py-28 lg:py-32">
  <div class="mx-auto max-w-3xl">
    <h1 class="text-5xl font-extrabold tracking-tight text-slate-900 md:text-7xl">
      Launch your SaaS <br class="hidden md:block" />
      <span class="text-gradient">in days, not months</span>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600 md:text-xl leading-relaxed">
      Validate demand with a fast, conversion-focused landing page.
      Capture leads in seconds — <span class="font-semibold text-slate-900">no backend required.</span>
    </p>
    <div class="mt-10 flex items-center justify-center gap-4">
      <a href="#lead-form" class="rounded-xl bg-brand-600 px-8 py-4 font-semibold text-white shadow-lg shadow-brand-600/30 transition-all hover:-translate-y-0.5 hover:bg-brand-700 hover:shadow-brand-600/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2">
        Join the waitlist
      </a>
    </div>
  </div>
</section>