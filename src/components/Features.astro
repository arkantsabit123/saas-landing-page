---
// src/components/Features.astro
import FeatureCard from './FeatureCard.astro';

const features = [
  { title: 'Lightning fast', desc: 'Static-first build ships in under one second.' },
  { title: 'Mobile ready', desc: 'Responsive at every breakpoint, 375 px to 1440 px.' },
  { title: 'Lead capture', desc: 'Forms wired to Google Sheets — no backend required.' },
];
---
<section id="features" class="bg-white/50 py-20 md:py-24">
  <div class="mx-auto max-w-6xl px-4 md:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center mb-16">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 md:text-4xl">
        Everything you need to launch
      </h2>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {features.map((f) => (
        <FeatureCard title={f.title} desc={f.desc} />
      ))}
    </div>
  </div>
</section>